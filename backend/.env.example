NODE_ENV=development
PORT=4000

# JWT signing secret for short-lived access tokens — generate with: openssl rand -hex 32
JWT_SECRET=

# Neon pooled connection (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection (Prisma CLI: migrations, studio)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
